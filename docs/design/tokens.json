{
  "$description": "kylet.se design tokens. Engine-neutral: the Keel build maps these onto its theme, style and motion APIs. docs/design/mockup/site.css is the reference rendering.",
  "color": {
    "canvas":        { "light": "#f5f5f3", "dark": "#0a0a0b", "use": "page background" },
    "surface":       { "light": "#ffffff", "dark": "#161618", "use": "cards, grouped lists" },
    "surface-2":     { "light": "#efefec", "dark": "#1f1f22", "use": "chips, hover and pressed rows" },
    "ink":           { "light": "#111113", "dark": "#f4f4f5", "use": "headings, primary text, primary button" },
    "ink-2":         { "light": "#45454b", "dark": "#b8b8bf", "use": "body copy (>= 7:1 on canvas)" },
    "ink-3":         { "light": "#66666d", "dark": "#9a9aa3", "use": "meta, captions (>= 4.5:1 on surface)" },
    "line":          { "light": "rgba(17,17,19,0.09)", "dark": "rgba(255,255,255,0.08)", "use": "hairlines" },
    "line-strong":   { "light": "rgba(17,17,19,0.16)", "dark": "rgba(255,255,255,0.16)", "use": "row separators, outlines" },
    "accent":        { "light": "#c2410c", "dark": "#ff8a4c", "use": "text links and arrows (underlined inside prose)" },
    "accent-strong": { "light": "#9a3412", "dark": "#ffa36e", "use": "text on accent tints" },
    "ember":         { "light": "#ff6b2c", "dark": "#ff6b2c", "use": "brand dot, decoration only, never text" },
    "focus":         { "light": "#1d4ed8", "dark": "#8ab4ff", "use": "2px focus ring, 3px offset" },
    "stage":         { "light": "#07080b", "dark": "#07080b", "use": "Keel scene window, dark in both modes" },
    "material":      { "light": "rgba(245,245,243,0.78)", "dark": "rgba(10,10,11,0.72)", "use": "sticky header with blur(20px) saturate(1.8)" }
  },
  "type": {
    "family": {
      "text": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif",
      "display": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI Variable Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif",
      "mono": "ui-monospace, 'SF Mono', 'Cascadia Code', 'Roboto Mono', Menlo, Consolas, monospace",
      "note": "System fonts only: no download, no layout shift. Wordmark is outlined from Geist (SIL OFL 1.1)."
    },
    "scale": {
      "hero":     { "size": "clamp(2.375rem, 1.55rem + 3.9vw, 4.5rem)", "weight": 700, "leading": 1.02, "tracking": "-0.035em" },
      "title":    { "size": "clamp(1.75rem, 1.35rem + 1.7vw, 2.625rem)", "weight": 700, "leading": 1.08, "tracking": "-0.028em" },
      "title-3":  { "size": "1.25rem", "weight": 650, "tracking": "-0.015em" },
      "headline": { "size": "1.0625rem", "weight": 600 },
      "body":     { "size": "1.0625rem", "weight": 400, "leading": 1.5 },
      "lede":     { "size": "clamp(1.0625rem, 1rem + 0.35vw, 1.25rem)", "leading": 1.5 },
      "callout":  { "size": "1rem" },
      "subhead":  { "size": "0.9375rem" },
      "footnote": { "size": "0.8125rem" },
      "caption":  { "size": "0.75rem" }
    },
    "measure": "40rem"
  },
  "space": { "unit": "4px", "steps": [4, 8, 12, 16, 20, 24, 32, 40, 56, 80, 120],
    "gutter": { "phone": "max(16px, safe-area insets)", "tablet (>=700px)": "32px", "desktop (>=1100px)": "48px" },
    "max-content": "1120px" },
  "radius": { "sm": "10px", "md": "16px", "lg": "24px", "pill": "999px", "tile": "25% of size" },
  "elevation": {
    "e1": { "light": "0 1px 2px rgba(17,17,19,.04), 0 0 0 1px line", "dark": "0 0 0 1px line" },
    "e2": { "light": "0 1px 2px rgba(17,17,19,.04), 0 12px 32px -12px rgba(17,17,19,.18), 0 0 0 1px line", "dark": "0 0 0 1px line, 0 16px 40px -16px rgba(0,0,0,.8)" },
    "note": "Dark mode separates with hairlines, not shadows."
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "press": "120ms: scale 0.97 (buttons), 0.985 (cards), background tint (rows)",
    "hover": "200ms: lift 2px and e1 to e2 on cards; arrow nudges 3px",
    "reveal": "420ms",
    "reduced-motion": "no transforms and no smooth scroll; press feedback becomes an opacity change; the Keel scene stays on its poster with a Play button"
  },
  "touch-target": "44px minimum for every link and button"
}
