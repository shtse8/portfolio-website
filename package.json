{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "biome check . && tsc --noEmit && bun test",
    "dev": "next dev --turbopack -p 4311",
    "format": "biome format --write src package.json biome.json next.config.ts tailwind.config.ts tsconfig.json postcss.config.mjs",
    "format:check": "biome format src package.json biome.json next.config.ts tailwind.config.ts tsconfig.json postcss.config.mjs",
    "generate:banners": "bun scripts/generate-oss-banners.mjs",
    "generate:covers": "bun scripts/generate-oss-covers.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "npx -y serve -s out -l 4311",
    "start": "next start -p 4311",
    "sync": "bun scripts/sync-github-portfolio.mjs && bun scripts/sync-stats.mjs",
    "sync:github": "bun scripts/sync-github-portfolio.mjs",
    "sync:stats": "bun scripts/sync-stats.mjs",
    "test": "bun test",
    "test:api": "cd api-rust && cargo test --locked",
    "test:cinematic": "bun scripts/check-cinematic-markers.mjs",
    "test:cinematic:export": "bun scripts/check-cinematic-markers.mjs --with-export"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.5",
    "ai": "^7.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.0.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "@sylphx/biome-config": "^0.4.1",
    "@types/bun": "^1.2.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
