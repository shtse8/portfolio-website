{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4311",
    "build": "next build",
    "start": "next start -p 4311",
    "preview": "npx -y serve -s out -l 4311",
    "lint": "biome check .",
    "format": "biome format --write src package.json biome.json next.config.ts tailwind.config.ts tsconfig.json postcss.config.mjs",
    "format:check": "biome format src package.json biome.json next.config.ts tailwind.config.ts tsconfig.json postcss.config.mjs",
    "lint:fix": "biome check --write .",
    "test:api": "cd api-rust && cargo test --locked",
    "lint:proto": "buf lint"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.5",
    "ai": "^7.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.23.24",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.16.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "@sylphx/biome-config": "^0.4.1"
  },
  "packageManager": "bun@1.3.12"
